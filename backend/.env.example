# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cannabis_intel
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cannabis_intel
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — CHANGE THIS in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-a-real-secret-in-production

# Initial Admin Account (used by setup_admin.py)
ADMIN_EMAIL=admin@cannabisintel.com
ADMIN_PASSWORD=Admin2026!
ADMIN_NAME=Platform Admin

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@cannabisintel.com
EMAIL_FROM_NAME=NJ Cannabis Intel

# SMS — Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Geocoding — Google Maps (optional but recommended)
GOOGLE_MAPS_API_KEY=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development
